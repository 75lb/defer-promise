{
  "name": "defer-promise",
  "author": "Lloyd Brookes <opensource@75lb.com>",
  "version": "3.0.1",
  "description": "Isomorphic function returning a deferred promise. Uses native `Promise.defer` if available, else polyfills.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/75lb/defer-promise.git"
  },
  "license": "MIT",
  "keywords": [
    "defer",
    "promise",
    "es6",
    "native",
    "deferred"
  ],
  "type": "module",
  "exports": {
    "import": "./index.js",
    "require": "./dist/index.cjs"
  },
  "files": [
    "index.js",
    "dist"
  ],
  "engines": {
    "node": ">=12.17"
  },
  "scripts": {
    "test": "npm run dist && test-runner test.js",
    "test:ci": "test-runner test.js",
    "dist": "rollup -c"
  },
  "devDependencies": {
    "rollup": "^4.59.0",
    "test-runner": "^0.10.1"
  }
}
